{% extends 'base.html.twig' %}
{% block title %}Mes Documents{% endblock %}
{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Mes Documents</h1>
    <a href="{{ path('app_document_upload') }}" class="px-4 py-2 rounded-md bg-red-600 text-white text-sm font-semibold hover:bg-red-700">+ Ajouter un document</a>
</div>

{% if documents|length == 0 %}
    <div class="bg-white border border-dashed border-gray-300 rounded-lg p-10 text-center text-gray-500">
        Aucun document envoyé pour le moment.
    </div>
{% else %}
    <div class="bg-white border border-gray-200 rounded-lg divide-y">
        {% for document in documents %}
            <div class="flex items-center justify-between p-4">
                <div>
                    <p class="font-medium">{{ document.categorieLabel }}</p>
                    <p class="text-xs text-gray-500">{{ document.nomFichier }} — mis à jour le {{ document.updatedAt|date('d/m/Y H:i') }}</p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="{{ asset('uploads/documents/' ~ document.nomFichier) }}" target="_blank" class="text-sm text-red-600 font-medium hover:underline">Télécharger</a>
                    <form method="post" action="{{ path('app_document_delete', {id: document.id}) }}" onsubmit="return confirm('Supprimer ce document ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-document-' ~ document.id) }}">
                        <button type="submit" class="text-sm text-gray-400 hover:text-red-600">Supprimer</button>
                    </form>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
