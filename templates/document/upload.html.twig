{% extends 'base.html.twig' %}
{% block title %}Ajouter un document{% endblock %}
{% block body %}
<h1 class="text-2xl font-bold mb-6">Ajouter un document</h1>
<div class="bg-white border border-gray-200 rounded-lg p-8 max-w-lg">
    {{ form_start(documentForm, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}
        {{ form_row(documentForm.categorie) }}
        {{ form_row(documentForm.fichierFile) }}
        <button type="submit" class="w-full py-2.5 rounded-md bg-red-600 text-white font-semibold hover:bg-red-700">Téléverser</button>
    {{ form_end(documentForm) }}
</div>
<a href="{{ path('app_document_list') }}" class="inline-block mt-4 text-sm text-gray-500 hover:text-red-600">&larr; Retour à mes documents</a>
{% endblock %}
