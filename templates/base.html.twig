<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Visa Canada{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">

<header class="bg-white border-b-4 border-red-600 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-bold text-xl text-red-600">
            <span class="text-2xl">🍁</span> Visa Canada
        </a>
        <nav class="hidden md:flex items-center gap-5 text-sm font-medium">
            <a href="{{ path('app_home') }}" class="hover:text-red-600">Accueil</a>
            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="hover:text-red-600">Mon Profil</a>
                <a href="{{ path('app_document_list') }}" class="hover:text-red-600">Mes Documents</a>
                <a href="{{ path('app_profile_edit') }}" class="hover:text-red-600">Compléter mon dossier</a>
                <a href="{{ path('app_statut') }}" class="hover:text-red-600">Statut de la demande</a>
            {% endif %}
            <a href="{{ path('app_aide') }}" class="hover:text-red-600">Aide</a>
            <a href="{{ path('app_contact') }}" class="hover:text-red-600">Contact</a>
            <a href="{{ path('app_a_propos') }}" class="hover:text-red-600">À propos</a>
        </nav>
        <div class="flex items-center gap-3 text-sm font-medium">
            {% if app.user %}
                <span class="text-gray-500 hidden sm:inline">{{ app.user.prenom }} {{ app.user.nom }}</span>
                <a href="{{ path('app_logout') }}" class="px-3 py-1.5 rounded-md bg-gray-900 text-white hover:bg-gray-700">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="px-3 py-1.5 rounded-md border border-gray-300 hover:border-red-600 hover:text-red-600">Connexion</a>
                <a href="{{ path('app_register') }}" class="px-3 py-1.5 rounded-md bg-red-600 text-white hover:bg-red-700">Inscription</a>
            {% endif %}
        </div>
    </div>
</header>

<main class="flex-1 max-w-6xl mx-auto w-full px-4 py-8">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 px-4 py-3 rounded-md {{ label == 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="bg-gray-900 text-gray-300 text-sm mt-auto">
    <div class="max-w-6xl mx-auto px-4 py-6 flex flex-col md:flex-row justify-between gap-2">
        <p>&copy; {{ "now"|date("Y") }} Visa Canada — Service de demande en ligne (démo).</p>
        <div class="flex gap-4">
            <a href="{{ path('app_aide') }}" class="hover:text-white">Aide</a>
            <a href="{{ path('app_contact') }}" class="hover:text-white">Contact</a>
            <a href="{{ path('app_a_propos') }}" class="hover:text-white">À propos</a>
        </div>
    </div>
</footer>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
