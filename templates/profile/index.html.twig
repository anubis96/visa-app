{% extends 'base.html.twig' %}
{% block title %}Mon Profil{% endblock %}
{% block body %}

{% if user.isDemandeEnvoyee %}
    <div class="mb-6 px-4 py-3 rounded-md bg-blue-50 text-blue-900 border border-blue-200 text-sm">
        Votre demande est en cours d'examen. Comme nous avons beaucoup des demandes à traiter, nous vous prions de patienter, une réponse vous sera donnée da.
    </div>
{% endif %}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Mon Profil</h1>
    <div class="flex items-center gap-3">
        {% if not user.isDemandeEnvoyee %}
            <a href="{{ path('app_profile_edit') }}" class="px-4 py-2 rounded-md border border-gray-300 text-sm font-semibold hover:border-red-600 hover:text-red-600">Compléter / Modifier</a>
        {% endif %}
        {% if user.tauxCompletion == 100 and not user.isDemandeEnvoyee %}
            <form method="post" action="{{ path('app_profile_send') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('send-profile-' ~ user.id) }}">
                <button type="submit" class="px-4 py-2 rounded-md bg-red-600 text-white text-sm font-semibold hover:bg-red-700">Envoyer</button>
            </form>
        {% endif %}
    </div>
</div>

<div class="grid md:grid-cols-2 gap-8">
    <div class="bg-white border border-gray-200 rounded-lg p-6 space-y-3 text-sm">
        <h2 class="font-semibold text-gray-500 uppercase text-xs tracking-wide mb-2">Informations personnelles</h2>
        <p><span class="text-gray-500">Nom :</span> {{ user.nom }}</p>
        <p><span class="text-gray-500">Prénom :</span> {{ user.prenom }}</p>
        <p><span class="text-gray-500">Email :</span> {{ user.email }}</p>
        <p><span class="text-gray-500">Numéro de passeport :</span> {{ user.numeroPasseport }}</p>
        <p><span class="text-gray-500">Date de naissance :</span> {{ user.dateNaissance ? user.dateNaissance|date('d/m/Y') : '—' }}</p>
        <p><span class="text-gray-500">Lieu de naissance :</span> {{ user.lieuNaissance ?: '—' }}</p>
        <p><span class="text-gray-500">Nationalité :</span> {{ user.nationalite ?: '—' }}</p>
        <p><span class="text-gray-500">Sexe :</span> {{ user.sexe ?: '—' }}</p>
        <p><span class="text-gray-500">Téléphone :</span> {{ user.telephone ?: '—' }}</p>
        <p><span class="text-gray-500">Adresse :</span> {{ user.adresse ?: '—' }}, {{ user.ville ?: '' }} {{ user.codePostal ?: '' }}</p>
        <p><span class="text-gray-500">Pays :</span> {{ user.pays ?: '—' }}</p>
        <p><span class="text-gray-500">Profession :</span> {{ user.profession ?: '—' }}</p>
        <p><span class="text-gray-500">Situation familiale :</span> {{ user.situationFamiliale ?: '—' }}</p>

        <div class="pt-3">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
                <span>Complétion du profil</span><span>{{ user.tauxCompletion }}%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-red-600 h-2 rounded-full" style="width: {{ user.tauxCompletion }}%"></div>
            </div>
        </div>
    </div>

    <div class="bg-blue-950 border-4 border-red-600 rounded-2xl p-6 text-white shadow-xl h-fit">
        <div class="flex justify-between items-start mb-6">
            <div>
                <p class="uppercase tracking-widest text-[10px] text-red-300">Canada</p>
                <p class="uppercase tracking-widest text-lg font-bold">Passport</p>
            </div>
            <span class="text-3xl">🍁</span>
        </div>
        <div class="grid grid-cols-3 gap-4 items-center">
            <div class="col-span-1">
                {% if user.photo %}
                    <img src="{{ vich_uploader_asset(user, 'photoFile') }}" 
         alt="Photo de {{ user.prenom }}" 
         class="w-20 h-24 object-cover rounded border border-white/30">
                                    {# <div class="w-20 h-24 bg-gray-300/20 border border-white/30 rounded flex items-center justify-center text-xs text-gray-300">Photo</div> #}

                    {# <img src="{{ asset('uploads/photos/' ~ user.photo) }}" alt="Photo de {{ user.prenom }}" class="w-20 h-24 object-cover rounded border border-white/30"> #}
                {% else %}
                    <div class="w-20 h-24 bg-gray-300/20 border border-white/30 rounded flex items-center justify-center text-xs text-gray-300">Photo</div>
                {% endif %}
            </div>
            <div class="col-span-2 text-xs space-y-1.5">
                <p><span class="text-gray-400">Type / Type</span><br><span class="font-semibold">P</span></p>
                <p><span class="text-gray-400">Nom de famille / Surname</span><br><span class="font-semibold">{{ user.nom }}</span></p>
                <p><span class="text-gray-400">Prénom / Given names</span><br><span class="font-semibold">{{ user.prenom }}</span></p>
            </div>
        </div>
        <div class="grid grid-cols-2 gap-3 text-xs mt-4 border-t border-white/20 pt-4">
            <p><span class="text-gray-400">Passport No.</span><br><span class="font-semibold tracking-wider">{{ user.numeroPasseport }}</span></p>
            <p><span class="text-gray-400">Nationality</span><br><span class="font-semibold">{{ user.nationalite ?: '—' }}</span></p>
            <p><span class="text-gray-400">Date of birth</span><br><span class="font-semibold">{{ user.dateNaissance ? user.dateNaissance|date('d M Y') : '—' }}</span></p>
            <p><span class="text-gray-400">Sex</span><br><span class="font-semibold">{{ user.sexe ?: '—' }}</span></p>
            <p><span class="text-gray-400">Date of issue</span><br><span class="font-semibold">{{ user.dateEmission ? user.dateEmission|date('d M Y') : '—' }}</span></p>
            <p><span class="text-gray-400">Date of expiry</span><br><span class="font-semibold">{{ user.dateExpiration ? user.dateExpiration|date('d M Y') : '—' }}</span></p>
        </div>
        <p class="text-[10px] text-gray-400 mt-4">Authority: {{ user.paysEmission ?: 'CANADA' }}</p>
    </div>
</div>
{% endblock %}
