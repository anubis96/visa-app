{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<div class="max-w-md mx-auto bg-white border border-gray-200 rounded-lg p-8">
    <h1 class="text-2xl font-bold mb-6 text-center">Connexion</h1>

    {% if error %}
        <div class="mb-4 px-4 py-3 rounded-md bg-red-50 text-red-800 border border-red-200 text-sm">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" class="space-y-4">
        <div>
            <label class="block text-sm font-medium mb-1">Email ou numéro de passeport</label>
            <input type="text" name="identifiant" value="{{ last_username }}" class="form-input w-full" required autofocus>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Mot de passe</label>
            <input type="password" name="password" class="form-input w-full" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="w-full py-2.5 rounded-md bg-red-600 text-white font-semibold hover:bg-red-700">Se connecter</button>
    </form>
    <p class="text-sm text-gray-500 mt-4 text-center">Pas encore de compte ? <a href="{{ path('app_register') }}" class="text-red-600 font-medium">S'inscrire</a></p>
</div>
{% endblock %}
